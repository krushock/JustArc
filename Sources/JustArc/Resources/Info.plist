			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<!-- Off until turned on in System Settings ▸ Keyboard ▸ Keyboard Shortcuts ▸
