	<integer>86400</integer>
	<!-- SUPublicEDKey is generated per developer with Sparkle's generate_keys and must
	     be added before shipping, otherwise Sparkle will refuse to install updates. -->

	<!-- NSSendFileTypes is what makes these appear for files selected in the Finder,
	     under Services in the contextual menu and the Finder menu, and only for the
	     kinds of file each one applies to. -->
	<!-- The titles are translated in each .lproj's ServicesMenu.strings, keyed by the
	     "default" title here. -->
	<!-- An NSRequiredContext, even an empty one, is what makes macOS show a service
	     without the user first turning it on in System Settings; with only a few
	     services for the selection, the Finder lists them in its right-click menu
	     itself rather than under Services. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key><string>Compress with JustArc</string>
