<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>JustArcQuickLook</string>
	<key>CFBundleDisplayName</key>
	<string>JustArc Archive Preview</string>
	<key>CFBundleExecutable</key>
	<string>JustArcQuickLook</string>
	<key>CFBundleIdentifier</key>
	<string>com.justarc.JustArc.QuickLook</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<!-- Kept the same as the app's; build-app.sh and release.sh copy them across. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Compression by 7-Zip, used under the GNU LGPL.</string>

	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>JustArcPreviewViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLIsDataBasedPreview</key>
			<false/>
			<key>QLSupportsSearchableItems</key>
			<false/>
			<!-- Every archive the app opens through 7-Zip. Disk images are left out:
			     reading one means mounting it, and the Finder has its own preview. -->
			<key>QLSupportedContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>org.7-zip.7-zip-archive</string>
				<string>com.rarlab.rar-archive</string>
				<string>public.tar-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<string>org.gnu.gnu-zip-tar-archive</string>
				<string>public.bzip2-archive</string>
				<string>public.tar-bzip2-archive</string>
				<string>org.tukaani.xz-archive</string>
				<string>org.tukaani.tar-xz-archive</string>
				<string>com.facebook.zst-archive</string>
				<string>com.facebook.tar-zst-archive</string>
				<string>public.cpio-archive</string>
				<string>com.microsoft.cab</string>
				<string>com.apple.xar-archive</string>
				<string>public.iso-image</string>
				<string>org.debian.deb-archive</string>
				<string>com.redhat.rpm-archive</string>
				<string>public.z-archive</string>
				<string>org.7-zip.lha-archive</string>
				<string>org.7-zip.arj-archive</string>
				<string>com.justarc.zstd</string>
				<string>com.justarc.tar-zstd</string>
				<string>com.justarc.lzh</string>
				<string>com.justarc.arj</string>
				<string>com.justarc.wim</string>
				<string>com.justarc.lzma</string>
				<string>com.justarc.tar-z</string>
				<string>com.justarc.cbt</string>
			</array>
		</dict>
	</dict>
</dict>
</plist>
